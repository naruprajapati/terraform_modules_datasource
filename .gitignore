# Local .terraform directories (plugins and provider caches)
**/.terraform/*

# .tfstate files (Contains sensitive infrastructure data and secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files as they likely contain sensitive credentials and environment configs
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform plan outputs (Plans can contain sensitive unencrypted data)
*.tfplan
tfplan

# Ignore lock file only if you are maintaining a reusable module (uncomment if needed)
*.terraform.lock.hcl